# App
APP_NAME=Fix My Kit API
API_HOST=0.0.0.0
API_PORT=8000
API_DOCS_ENABLED=true
LOG_LEVEL=INFO
LOG_DIR=data/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
LOG_JSON=true
FRONTEND_PORT=5173
VITE_PROXY_TARGET=http://backend:8000
# База для QR и shorten-url на бэкенде
PUBLIC_FRONTEND_BASE_URL=https://fixmykit.local
# Та же база для фронта при сборке QR 
VITE_PUBLIC_FRONTEND_BASE_URL=https://app.fixmykit.karasikoff.ru
JWT_SECRET_KEY=secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin_password

#win+r -> powershell -> python -c "import secrets; print(secrets.token_urlsafe(32))" -> copy and paste into JWT_SECRET_KEY and paste into .env/.env.example
# PostgreSQL 
POSTGRES_DB=fixmykit
POSTGRES_USER=fixmykit
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Yandex Tracker
TRACKER_BASE_URL=https://api.tracker.yandex.net/v3
TRACKER_TOKEN=
TRACKER_ORG_ID=
TRACKER_QUEUE=
TRACKER_TIMEOUT_SECONDS=15

# Триггер Yandex Tracker
# POST …/api/webhooks/yandex-tracker
# заголовок X-Tracker-Webhook-Secret
TRACKER_WEBHOOK_SECRET=
TRACKER_WEBHOOK_ACTOR_LOGIN=tracker_webhook

# Вложения заявок (временно на диске до Трекера)
UPLOAD_DIR=data/uploads
ATTACHMENT_MAX_BYTES=134217728
ATTACHMENT_MAX_PER_REQUEST=10
ATTACHMENT_ORPHAN_MAX_AGE_DAYS=30
TRACKER_ATTACHMENT_TIMEOUT_SECONDS=600

# Redis: SSE-тикеты и pub/sub между воркерами uvicorn
REDIS_URL=redis://localhost:6379/0
REALTIME_BACKEND=redis
REDIS_SSE_CHANNEL=fixmykit:sse
SSE_TICKET_TTL_SECONDS=300

# JWT в httpOnly cookie (фронт не хранит токен в localStorage)
AUTH_COOKIE_NAME=fmk_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Сокращение URL для QR (clck.ru)
CLCK_SHORTENER_ENABLED=true
