#win+r -> powershell -> python -c "import secrets; print(secrets.token_urlsafe(32))"
# App
APP_NAME=Fix My Kit API
API_DOCS_ENABLED=false
LOG_LEVEL=INFO
LOG_DIR=/data/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
LOG_JSON=true
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_LOGIN=
ADMIN_PASSWORD=

# CORS: origin фронта
# Должен совпадать с публичным URL приложения, например https://app.fixmykit.example.com
CORS_ORIGINS=https://app.fixmykit.example.com

# Базовый URL фронта для ссылок из бэка QR и т.п.
PUBLIC_FRONTEND_BASE_URL=https://app.fixmykit.example.com

# PostgreSQL 
POSTGRES_DB=fixmykit
POSTGRES_USER=fixmykit
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Yandex Tracker
TRACKER_BASE_URL=https://api.tracker.yandex.net/v3
TRACKER_TOKEN=
TRACKER_ORG_ID=
TRACKER_QUEUE=
TRACKER_TIMEOUT_SECONDS=15

# Триггер Yandex Tracker
# POST …/api/webhooks/yandex-tracker
# заголовок X-Tracker-Webhook-Secret
TRACKER_WEBHOOK_SECRET=
TRACKER_WEBHOOK_ACTOR_LOGIN=tracker_webhook

# Полный URL API
VITE_API_BASE_URL=https://api.fixmykit.example.com

# Вложения (смонтируйте каталог в Docker, чтобы файлы переживали перезапуск)
UPLOAD_DIR=/data/uploads
ATTACHMENT_MAX_BYTES=134217728
ATTACHMENT_MAX_PER_REQUEST=10
ATTACHMENT_ORPHAN_MAX_AGE_DAYS=30
TRACKER_ATTACHMENT_TIMEOUT_SECONDS=600

# Redis: SSE-тикеты и pub/sub (сервис redis в docker-compose.prod.yml)
REDIS_URL=redis://redis:6379/0
REALTIME_BACKEND=redis
REDIS_SSE_CHANNEL=fixmykit:sse
SSE_TICKET_TTL_SECONDS=300