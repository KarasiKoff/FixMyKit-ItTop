# Сценарий 1: локальная разработка
# 1) docker compose --env-file .env up -d
# 2) docker compose -p fmk-monitoring -f docker-compose.monitoring.yml -f docker-compose.monitoring.local.yml --env-file .env.monitoring up -d --build

MONITORING_ENVIRONMENT=development

# backend:8000 — если мониторинг поднят с docker-compose.monitoring.local.yml (общая сеть fixmykit-dev)
# host.docker.internal:8000 — если Prometheus без overlay, но API на localhost:8000
BACKEND_METRICS_TARGET=backend:8000

POSTGRES_DB=fixmykit
POSTGRES_USER=fixmykit
POSTGRES_PASSWORD=fixmykit
POSTGRES_PORT=5432
# Postgres для дашборда «Операции» (dev-сеть fixmykit-dev, сервис postgres)
GRAFANA_POSTGRES_URL=postgres:5432

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
GRAFANA_ROOT_URL=http://localhost:3000

TG_BOT_ALERT_TOKEN=
TG_ALERT_CHAT_ID=

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
POSTGRES_EXPORTER_PORT=9187
CADVISOR_PORT=8089

# Каталог с fixmykit.log (dev: ./data/logs с хоста)
PROMTAIL_LOG_DIR=./data/logs
