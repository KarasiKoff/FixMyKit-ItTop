# Сценарий C: мониторинг на отдельном VPS (prod на другой машине)
#
# monitoring/PRODUCTION.md — раздел «Два VPS»
#
# BACKEND_METRICS_TARGET — IP prod-сервера, куда разрешён scrape /metrics (через nginx allowlist
#   или приватный порт). Пример: 203.0.113.10:443 если scrape по HTTPS через api.* 
#   или 10.0.0.1:8001 если API проброшен только в VPN/приватную сеть.
BACKEND_METRICS_TARGET=203.0.113.10:8001

MONITORING_ENVIRONMENT=production

# PostgreSQL на prod-сервере (firewall + pg_hba только с IP monitoring-VPS)
POSTGRES_EXPORTER_HOST=203.0.113.10
POSTGRES_DB=fixmykit
POSTGRES_USER=grafana_ro
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
GRAFANA_POSTGRES_URL=203.0.113.10:5432

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
GRAFANA_ROOT_URL=https://grafana.fixmykit.example.com

TG_BOT_ALERT_TOKEN=
TG_ALERT_CHAT_ID=

GRAFANA_PORT=127.0.0.1:3000:3000
PROMETHEUS_PORT=127.0.0.1:9090:9090
ALERTMANAGER_PORT=127.0.0.1:9093:9093
LOKI_PORT=127.0.0.1:3100:3100
CADVISOR_PORT=127.0.0.1:8089:8080
POSTGRES_EXPORTER_PORT=127.0.0.1:9187:9187

# Promtail на monitoring-VPS не видит логи prod (volume на другой машине).
# Логи в Loki — только если на prod отдельно настроен promtail → этот Loki (см. PRODUCTION.md).
