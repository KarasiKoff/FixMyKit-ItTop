# Шаблон для .env.monitoring — выберите сценарий и скопируйте нужный пример:
#
#   cp .env.monitoring.local.example .env.monitoring      # 1. локалка (dev compose)
#   cp .env.monitoring.prod.example .env.monitoring       # 2. prod + мониторинг вместе
#   cp .env.monitoring.prod-standalone.example .env.monitoring  # 3. prod отдельно
#
# Команды запуска — monitoring/README.md

MONITORING_ENVIRONMENT=local
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
GRAFANA_ROOT_URL=http://localhost:3000
TG_BOT_ALERT_TOKEN=
TG_ALERT_CHAT_ID=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
POSTGRES_EXPORTER_PORT=9187
