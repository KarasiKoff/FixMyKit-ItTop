# Сценарий 3: prod уже запущен, мониторинг поднимается отдельно
# 1) docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# 2) docker compose -p fmk-monitoring -f docker-compose.monitoring.yml -f docker-compose.monitoring.prod-link.yml --env-file .env.monitoring up -d --build

MONITORING_ENVIRONMENT=production

BACKEND_METRICS_TARGET=backend:8000

POSTGRES_DB=fixmykit
POSTGRES_USER=fixmykit
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
GRAFANA_ROOT_URL=http://localhost:3000

TG_BOT_ALERT_TOKEN=
TG_ALERT_CHAT_ID=

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
POSTGRES_EXPORTER_PORT=9187
GRAFANA_POSTGRES_URL=postgres:5432

# Prod: логи в volume fixmykit-logs-prod (задаётся в prod-link overlay)
