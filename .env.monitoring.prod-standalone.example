# Сценарий B: prod уже на VPS, мониторинг — отдельный compose (fmk-monitoring)
# monitoring/PRODUCTION.md — раздел «B. Prod и мониторинг раздельно»

MONITORING_ENVIRONMENT=production

BACKEND_METRICS_TARGET=backend:8000

POSTGRES_DB=fixmykit
POSTGRES_USER=fixmykit
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
# Публичный URL Grafana (HTTPS, совпадает с nginx server_name)
GRAFANA_ROOT_URL=https://grafana.fixmykit.example.com

TG_BOT_ALERT_TOKEN=
TG_ALERT_CHAT_ID=
# Jira Service Management — Alerts → Integrations → Prometheus
JSM_OPS_API_KEY=
JSM_OPS_TEAM=IT-Support
# Прокси для alertserver → api.telegram.org (profile telegram-vpn + sing-box)
# TELEGRAM_HTTP_PROXY=http://sing-box:1080

# Только localhost на VPS; Grafana снаружи — через nginx (deploy/nginx-fixmykit-monitoring.example.conf)
GRAFANA_PORT=127.0.0.1:3000:3000
PROMETHEUS_PORT=127.0.0.1:9090:9090
ALERTMANAGER_PORT=127.0.0.1:9093:9093
LOKI_PORT=127.0.0.1:3100:3100
CADVISOR_PORT=127.0.0.1:8089:8080
POSTGRES_EXPORTER_PORT=127.0.0.1:9187:9187
GRAFANA_POSTGRES_URL=postgres:5432

# Prod: логи в volume fixmykit-logs-prod (задаётся в prod-link overlay)
