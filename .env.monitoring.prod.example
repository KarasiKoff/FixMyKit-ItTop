# Сценарий A: prod + мониторинг на одном VPS, одной командой
# monitoring/PRODUCTION.md — раздел «A. Всё на одном сервере»
# docker compose -f docker-compose.prod.yml -f docker-compose.monitoring.yml -f docker-compose.monitoring.prod-bundle.yml --env-file .env.production --env-file .env.monitoring up -d --build

MONITORING_ENVIRONMENT=production

BACKEND_METRICS_TARGET=backend:8000

# Те же учётные данные, что в .env.production (postgres-exporter → сервис postgres)
POSTGRES_DB=fixmykit
POSTGRES_USER=fixmykit
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
GRAFANA_POSTGRES_URL=postgres:5432

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
GRAFANA_ROOT_URL=https://grafana.fixmykit.example.com

TG_BOT_ALERT_TOKEN=
TG_ALERT_CHAT_ID=

# Только localhost; Grafana — через nginx на поддомене (monitoring/PRODUCTION.md)
PROMETHEUS_PORT=127.0.0.1:9090:9090
GRAFANA_PORT=127.0.0.1:3000:3000
CADVISOR_PORT=127.0.0.1:8089:8080
ALERTMANAGER_PORT=127.0.0.1:9093:9093
LOKI_PORT=127.0.0.1:3100:3100
POSTGRES_EXPORTER_PORT=127.0.0.1:9187:9187
