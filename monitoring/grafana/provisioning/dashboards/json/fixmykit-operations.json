          "rawSql": "SELECT COALESCE(a.name, 'Без аудитории') AS \"Аудитория\", COUNT(d.id)::double precision AS \"Устройств\", COUNT(*) FILTER (WHERE d.repair_status::text = 'IN_REPAIR')::double precision AS \"В ремонте\", ROUND(100.0 * COUNT(*) FILTER (WHERE d.repair_status::text = 'IN_REPAIR') / NULLIF(COUNT(d.id), 0), 1) AS \"% в ремонте\", (SELECT COUNT(*)::double precision FROM repair_requests rr WHERE rr.status::text IN ('OPEN', 'IN_PROGRESS', 'NEEDS_INFO') AND (rr.audience_id IS NOT DISTINCT FROM a.id OR EXISTS (SELECT 1 FROM devices d_rr WHERE d_rr.id = rr.device_id AND d_rr.audience_id IS NOT DISTINCT FROM a.id))) AS \"Активных заявок\" FROM devices d LEFT JOIN audience a ON a.id = d.audience_id GROUP BY a.id, a.name ORDER BY \"В ремонте\" DESC NULLS LAST, \"Устройств\" DESC",
