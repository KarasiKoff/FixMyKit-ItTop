      "pluginVersion": "12.3.1",
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT rr.id::text AS \"ID\", status::text AS \"Статус\", ROUND(EXTRACT(EPOCH FROM (NOW() - rr.created_at))/3600, 1)::double precision AS \"Часов открыта\", COALESCE(d.inventory_number, '—') AS \"Инв. №\", COALESCE(a.name, aud.name, '—') AS \"Аудитория\", rr.created_at AS \"Создана\" FROM repair_requests rr LEFT JOIN devices d ON d.id = rr.device_id LEFT JOIN audience a ON a.id = rr.audience_id LEFT JOIN audience aud ON aud.id = d.audience_id WHERE rr.status::text IN ('OPEN', 'IN_PROGRESS', 'NEEDS_INFO') AND rr.created_at < NOW() - INTERVAL '3 days' ORDER BY rr.created_at ASC LIMIT 100",
          "refId": "A"
        }
      ],
      "title": "Активные > 3 дней",
      "type": "table"
    }
