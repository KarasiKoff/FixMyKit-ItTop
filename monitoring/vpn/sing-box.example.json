{
  "log": { "level": "warn" },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "0.0.0.0",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy",
      "server": "VPN_SERVER_HOST",
      "server_port": 443,
      "uuid": "YOUR_UUID",
      "tls": {
        "enabled": true,
        "server_name": "SNI_OR_DOMAIN",
        "utls": { "enabled": true, "fingerprint": "chrome" },
        "reality": {
          "enabled": true,
          "public_key": "REALITY_PUBLIC_KEY",
          "short_id": "SHORT_ID"
        }
      }
    },
    { "type": "direct", "tag": "direct" }
  ],
  "route": {
    "rules": [
      {
        "inbound": "mixed-in",
        "action": "sniff",
        "timeout": "1s"
      }
    ],
    "final": "proxy"
  }
}
