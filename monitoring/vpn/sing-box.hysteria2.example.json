{
  "log": {
    "level": "warn"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "0.0.0.0",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "hysteria2",
      "tag": "proxy",
      "server": "YOUR_HYSTERIA_HOST",
      "server_port": 443,
      "password": "PASTE_PASSWORD_FROM_SUBSCRIPTION",
      "tls": {
        "enabled": true,
        "server_name": "YOUR_HYSTERIA_HOST",
        "alpn": [
          "h3"
        ]
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "inbound": "mixed-in",
        "action": "sniff",
        "timeout": "1s"
      }
    ],
    "final": "proxy"
  }
}